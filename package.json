{
    "name": "zimaleto",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "biome check --error-on-warnings .",
        "lint:fix": "biome check --write .",
        "test": "turbo run test --filter=./packages/*",
        "test:unit": "turbo run test:unit",
        "test:watch": "vitest --project \"!*(dist)\"",
        "test:ui": "vitest --ui --project \"!*(dist)\"",
        "coverage": "vitest run --coverage --project \"!*(dist)\"",
        "size": "turbo run size --filter=./packages/*",
        "verify": "pnpm lint && turbo run typecheck test build size",
        "changeset": "changeset",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "husky": "^9.1.7",
        "playwright": "catalog:",
        "turbo": "^2.11.10",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
