{
    "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!**/.claude"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "attributePosition": "multiline"
        }
    },
    "markdown": {
        "formatter": {
            "enabled": false
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "domains": {
            "react": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "style": {
                "noDefaultExport": "error",
                "noEnum": "error",
                "useConsistentTypeDefinitions": {
                    "level": "error",
                    "options": {
                        "style": "type"
                    }
                },
                "useExportType": "error",
                "useImportType": "error"
            },
            "suspicious": {
                "noExplicitAny": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/*.config.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noDefaultExport": "off"
                    }
                }
            }
        }
    ]
}
