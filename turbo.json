{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "typecheck": {},
        "test": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"]
        },
        "test:unit": {},
        "size": {
            "dependsOn": ["build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
