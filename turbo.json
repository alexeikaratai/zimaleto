{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig.base.json"],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
        },
        "typecheck": {
            "dependsOn": ["transit"]
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"]
        },
        "test:unit": {
            "dependsOn": ["transit"]
        },
        "size": {
            "dependsOn": ["build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
